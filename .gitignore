result
result-*
.direnv/
__pycache__/
*.pyc
.venv/
states/
.lake/
proofs/lean/**/.runs/
results/omp/
# Per-cell session stores (a fresh cell keeps its attempts under results/<cell>/attempt-NNN/omp/):
# the transcripts are evidence, but they are large and per-run, so the audit's bounded extract is what
# gets committed beside the rows (results/route-b-cell-reuse.md precedent).
results/**/omp/

# TLC state pools: one private directory per run (the planner's ruling), so a `-cleanup` cannot delete a
# sibling run's pool mid-enumeration. The shared `states/` above is TLC's default; this is ours.
.tlc-states/

# LaTeX build artifacts (paper/)
paper/*.aux
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
